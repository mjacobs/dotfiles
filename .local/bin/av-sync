#!/bin/bash

HOSTS_FILE="${AV_SYNC_HOSTS_FILE:-$HOME/.config/agentsview/sync-hosts}"
HOSTS=()
if [[ ! -r "$HOSTS_FILE" ]]; then
  echo "missing host list: $HOSTS_FILE" >&2
  exit 1
fi
while IFS= read -r host; do
  [[ -z "$host" || "$host" == \#* ]] && continue
  HOSTS+=("$host")
done <"$HOSTS_FILE"

for HOST in "${HOSTS[@]}"; do
  echo "--------------------------------------------------"
  echo "Updating Agents View on: $HOST"
  echo "--------------------------------------------------"

  # Run commands via SSH for all hosts to ensure uniformity
  if ssh "$HOST" "agentsview update --yes && systemctl --user restart agentsview.service"; then
    echo "Successfully updated and restarted on $HOST"
  else
    echo "FAILED to update or restart on $HOST"
  fi
done

echo "--------------------------------------------------"
echo "Sync complete."
