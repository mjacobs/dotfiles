#!/usr/bin/env bash
set -euo pipefail

### zsh ########################################################################
# zsh completions are owned by .zshrc (regen_zsh_completion_if_needed), which
# auto-regenerates a tool's completion whenever its binary is newer than the
# cache. This script is only the force-regen escape hatch: clear the cache and
# the next interactive zsh rebuilds everything. Do NOT add zsh generators here
# — add tools to the regen list in .zshrc instead.

ZSH_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
BASH_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/bash/completions"

mkdir -p "$ZSH_DIR" "$BASH_DIR"

echo "zsh: clearing cached completions ($ZSH_DIR) and compdump"
rm -f "$ZSH_DIR"/_* "${ZDOTDIR:-$HOME}"/.zcompdump*
echo "zsh: completions will regenerate on next shell start"

### bash (fallback shell) ######################################################

have() {
  command -v "$1" >/dev/null 2>&1
}

bash_gen() {
  local cmd="$1"
  local out="$2"
  shift 2
  local tmpfile="$BASH_DIR/$out.$$.tmp"

  have "$cmd" || return 0

  printf 'bash: generating %s\n' "$out"
  if "$@" 2>/dev/null | sed '/./,$!d; s/`/\\`/g' >|"$tmpfile" && [[ -s "$tmpfile" ]]; then
    mv -f "$tmpfile" "$BASH_DIR/$out"
  else
    rm -f "$tmpfile"
    printf 'bash: skipped %s\n' "$out" >&2
  fi
}

bash_gen kubectl kubectl.bash kubectl completion bash
bash_gen docker docker.bash docker completion bash
bash_gen gh gh.bash gh completion -s bash
bash_gen tailscale tailscale.bash tailscale completion bash
bash_gen mise mise.bash mise completion bash
bash_gen helm helm.bash helm completion bash
bash_gen kind kind.bash kind completion bash
bash_gen task task.bash task --completion bash
