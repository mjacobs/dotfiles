# Brewfile — Linuxbrew (/home/linuxbrew/.linuxbrew) package manifest.
#
# Curated from `brew bundle dump` on 2026-07-06 (111 formulae installed via
# dependency chains; this file lists only the leaves worth reinstalling
# deliberately — `brew bundle` will pull in whatever those leaves need).
#
# Policy (see ~/CLAUDE.md): brew is for standalone CLIs that aren't fresh
# enough in dnf, or that dnf doesn't ship at all. Things dnf now owns
# (bat, jq, fzf, git-delta, zoxide, glow, lsd, ripgrep, etc — see
# ~/.config/dnf-packages.txt) are intentionally NOT listed here even though
# some lingered as brew leaves at audit time; don't reinstall them via brew.
#
# yadm itself is brew-only on Fedora (not in Fedora repos — verified via
# `dnf info yadm` returning nothing).

################################################################################
# Taps actually in use below
################################################################################
tap "kenn-io/tap", "https://github.com/kenn-io/homebrew-tap.git", trusted: true

################################################################################
# Core (brew-only, genuinely used)
################################################################################
# Dotfiles manager itself — not in Fedora repos
brew "yadm"
# Colorize kubectl output — used by the `k` alias in aliases.sh
brew "kubecolor"
# Upgrade-everything runner — ~/.config/topgrade.toml is tracked
brew "topgrade"
# Extra zsh completions, sourced via fpath in .zshrc
brew "zsh-completions"
# Bash completion framework (some tools only ship bash completions)
brew "bash-completion@2"
# GNU compiler collection — needed as a native build toolchain for cargo/npm
# native extensions on this machine
brew "gcc"
# macOS does not ship GnuPG; yadm needs it to decrypt the private archive.
brew "gnupg" if OS.mac?
# Use the native Keychain-aware prompt when GnuPG unlocks the archive key.
brew "pinentry-mac" if OS.mac?

################################################################################
# Fonts
################################################################################
cask "font-symbols-only-nerd-font"

################################################################################
# VS Code extensions (tracked ~/.config/Code/User/settings.json)
################################################################################
vscode "anthropic.claude-code"
vscode "esbenp.prettier-vscode"
vscode "kilocode.kilo-code"
vscode "openai.chatgpt"
vscode "saoudrizwan.claude-dev"

################################################################################
# Go tools (brew bundle's `go` directive == `go install` tracking, separate
# from the mise-managed go toolchain)
################################################################################
