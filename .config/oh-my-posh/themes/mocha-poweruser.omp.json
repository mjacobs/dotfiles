{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ if .Root }}  {{ end }}{{ .UserName }}@{{ .HostName }} │ {{ .Folder }}",
  "palette": {
    "base": "#1e1e2e",
    "mantle": "#181825",
    "crust": "#11111b",
    "surface0": "#313244",
    "surface1": "#45475a",
    "surface2": "#585b70",
    "overlay0": "#6c7086",
    "overlay1": "#7f849c",
    "overlay2": "#9399b2",
    "text": "#cdd6f4",
    "subtext1": "#bac2de",
    "subtext0": "#a6adc8",
    "rosewater": "#f5e0dc",
    "flamingo": "#f2cdcd",
    "pink": "#f5c2e7",
    "mauve": "#cba6f7",
    "red": "#f38ba8",
    "maroon": "#eba0ac",
    "peach": "#fab387",
    "yellow": "#f9e2af",
    "green": "#a6e3a1",
    "teal": "#94e2d5",
    "sky": "#89dceb",
    "sapphire": "#74c7ec",
    "blue": "#89b4fa",
    "lavender": "#b4befe"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:crust",
          "background": "p:red",
          "template": "  "
        },
        {
          "type": "session",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:crust",
          "background": "p:lavender",
          "background_templates": [
            "{{ if .SSHSession }}p:peach{{ end }}"
          ],
          "template": " {{ if .SSHSession }} {{ end }}{{ .UserName }}<p:surface1>@</>{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:crust",
          "background": "p:blue",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "",
            "folder_icon": "",
            "folder_separator_icon": "<p:surface1>  </>"
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:crust",
          "background": "p:green",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:maroon{{ end }}",
            "{{ if gt .Ahead 0 }}p:teal{{ end }}",
            "{{ if gt .Behind 0 }}p:flamingo{{ end }}"
          ],
          "options": {
            "fetch_status": true,
            "fetch_stash_count": true,
            "branch_icon": " ",
            "commit_icon": " ",
            "tag_icon": " "
          },
          "template": " {{ .HEAD }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if gt .Ahead 0 }}  {{ .Ahead }}{{ end }}{{ if gt .Behind 0 }}  {{ .Behind }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} "
        },
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:crust",
          "background": "p:green",
          "background_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": " {{ if gt .Code 0 }} {{ reason .Code }}{{ else }}{{ end }} "
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "background": "p:sky",
          "foreground": "p:crust",
          "template": "{{ if .Env.CLAUDE_LIMITS }} {{ .Env.CLAUDE_LIMITS }} {{ end }}"
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "background": "p:mauve",
          "foreground": "p:crust",
          "template": "{{ if .Env.AI_USAGE }} {{ .Env.AI_USAGE }} {{ end }}"
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:crust",
          "background": "p:peach",
          "options": {
            "threshold": 2000,
            "style": "round"
          },
          "template": "  {{ .FormattedMs }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:crust",
          "background": "p:surface2",
          "options": {
            "time_format": "15:04:05"
          },
          "template": "  {{ .CurrentDate | date .Format }} "
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "kubectl",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:crust",
          "background": "p:sapphire",
          "template": "  {{ .Context }}{{ if .Namespace }}<p:surface1>  </>{{ .Namespace }}{{ end }} "
        },
        {
          "type": "gcp",
          "style": "diamond",
          "leading_diamond": "<transparent,p:mauve></>",
          "trailing_diamond": "",
          "foreground": "p:crust",
          "background": "p:mauve",
          "template": " 󱇶 {{ .Project }} "
        },
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": "<transparent,p:green></>",
          "trailing_diamond": "",
          "foreground": "p:crust",
          "background": "p:green",
          "options": {
            "fetch_version": true,
            "display_mode": "files"
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "go",
          "style": "diamond",
          "leading_diamond": "<transparent,p:sky></>",
          "trailing_diamond": "",
          "foreground": "p:crust",
          "background": "p:sky",
          "options": {
            "fetch_version": true,
            "display_mode": "files"
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": "<transparent,p:yellow></>",
          "trailing_diamond": "",
          "foreground": "p:crust",
          "background": "p:yellow",
          "options": {
            "fetch_version": true,
            "display_mode": "files"
          },
          "template": "  {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} "
        },
        {
          "type": "rust",
          "style": "diamond",
          "leading_diamond": "<transparent,p:peach></>",
          "trailing_diamond": "",
          "foreground": "p:crust",
          "background": "p:peach",
          "options": {
            "fetch_version": true,
            "display_mode": "files"
          },
          "template": "  {{ .Full }} "
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:mauve",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": "❯ "
        }
      ],
      "type": "prompt"
    }
  ]
}
