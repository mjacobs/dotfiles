{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "version": 4,
    "blocks": [
        {
            "alignment": "left",
            "type": "prompt",
            "segments": [
                {
                    "type": "os",
                    "style": "diamond",
                    "leading_diamond": "",
                    "background": "#cba6f7",
                    "foreground": "#1e1e2e",
                    "template": "{{ if .WSL }}WSL at {{ end }}{{ .Icon }} "
                },
                {
                    "type": "session",
                    "style": "diamond",
                    "trailing_diamond": "",
                    "background": "#cba6f7",
                    "foreground": "#1e1e2e",
                    "template": "<#1e1e2e>|</> {{ .UserName }}@{{ .HostName }} "
                },
                {
                    "type": "path",
                    "style": "diamond",
                    "leading_diamond": "<transparent,#89b4fa></>",
                    "trailing_diamond": "",
                    "background": "#89b4fa",
                    "foreground": "#1e1e2e",
                    "options": {
                        "style": "agnoster_short",
                        "folder_icon": "…",
                        "folder_separator_icon": "<transparent>  </>",
                        "home_icon": ""
                    },
                    "template": " {{ .Path }} "
                },
                {
                    "type": "git",
                    "style": "powerline",
                    "powerline_symbol": "",
                    "background": "#a6e3a1",
                    "background_templates": [
                        "{{ if or (.Working.Changed) (.Staging.Changed) }}#f9e2af{{ end }}",
                        "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#fab387{{ end }}",
                        "{{ if gt .Ahead 0 }}#b4befe{{ end }}",
                        "{{ if gt .Behind 0 }}#b4befe{{ end }}"
                    ],
                    "foreground": "#1e1e2e",
                    "options": {
                        "fetch_status": true
                    },
                    "template": " {{ .HEAD }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }}{{ if .Staging.Changed }}<#f38ba8>  {{ .Staging.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} "
                },
                {
                    "type": "go",
                    "style": "powerline",
                    "powerline_symbol": "",
                    "background": "#89dceb",
                    "foreground": "#1e1e2e",
                    "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
                },
                {
                    "type": "python",
                    "style": "powerline",
                    "powerline_symbol": "",
                    "background": "#f9e2af",
                    "foreground": "#1e1e2e",
                    "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} "
                },
                {
                    "type": "rust",
                    "style": "powerline",
                    "powerline_symbol": "",
                    "background": "#fab387",
                    "foreground": "#1e1e2e",
                    "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
                },
                {
                    "type": "node",
                    "style": "powerline",
                    "powerline_symbol": "",
                    "background": "#94e2d5",
                    "foreground": "#1e1e2e",
                    "template": "  {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} "
                },
                {
                    "type": "status",
                    "style": "powerline",
                    "powerline_symbol": "",
                    "background": "#f38ba8",
                    "foreground": "#1e1e2e",
                    "template": "<transparent> </> {{ reason .Code }} "
                }
            ]
        },
        {
            "alignment": "right",
            "type": "prompt",
            "segments": [
                {
                    "type": "text",
                    "style": "plain",
                    "foreground": "transparent",
                    "template": " "
                },
                {
                    "type": "text",
                    "style": "diamond",
                    "leading_diamond": "",
                    "background": "#313244",
                    "foreground": "#cdd6f4",
                    "template": "{{ if or .Env.CODEX_LIMITS .Env.CLAUDE_LIMITS }}{{ if .Env.CODEX_LIMITS }} <#94e2d5>{{ .Env.CODEX_LIMITS }}</>{{ end }}{{ if and .Env.CODEX_LIMITS .Env.CLAUDE_LIMITS }} <#7f849c>│</>{{ end }}{{ if .Env.CLAUDE_LIMITS }} <#89dceb>{{ .Env.CLAUDE_LIMITS }}</>{{ end }} {{ end }}"
                },
                {
                    "type": "text",
                    "style": "diamond",
                    "leading_diamond": "",
                    "background": "#45475a",
                    "foreground": "#cba6f7",
                    "template": "{{ if .Env.AI_USAGE }} {{ .Env.AI_USAGE }} {{ end }}"
                },
                {
                    "type": "executiontime",
                    "style": "diamond",
                    "leading_diamond": "",
                    "background": "#313244",
                    "foreground": "#cdd6f4",
                    "options": {
                        "style": "dallas",
                        "threshold": 500
                    },
                    "template": " {{ .FormattedMs }}s "
                },
                {
                    "type": "time",
                    "style": "plain",
                    "background": "#313244",
                    "foreground": "#a6e3a1",
                    "options": {
                        "time_format": "15:04:05 | Monday"
                    },
                    "template": "<transparent>  </>{{ .CurrentDate | date .Format }} "
                }
            ]
        },
        {
            "alignment": "left",
            "newline": true,
            "type": "prompt",
            "segments": [
                {
                    "type": "status",
                    "style": "plain",
                    "foreground": "#a6e3a1",
                    "foreground_templates": [
                        "{{ if gt .Code 0 }}#f38ba8{{ end }}"
                    ],
                    "options": {
                        "always_enabled": true
                    },
                    "template": "❯ "
                }
            ]
        }
    ],
    "console_title_template": "{{if .Root}} ⚡ {{end}}{{.Folder | replace \"~\" \"\" }} @ {{.HostName}}",
    "final_space": true
}
