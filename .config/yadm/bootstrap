#!/usr/bin/env bash
# ~/.config/yadm/bootstrap
#
# Runs automatically after `yadm clone` on a new machine, and can be re-run
# any time via `yadm bootstrap`. Idempotent — every step is guarded so it's
# safe to run repeatedly (e.g. after adding a new dnf package to the
# manifest, or after wiping ~/.oh-my-zsh).
set -euo pipefail

################################################################################
# helpers
################################################################################
log() { printf '\n\033[1;36m==>\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$1" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

FOLLOWUPS=()

################################################################################
# a. Fedora system packages (dnf)
################################################################################
log "System packages (dnf)"

OS_ID=""
[[ -f /etc/os-release ]] && OS_ID="$(. /etc/os-release && echo "${ID:-}")"

if [[ "$OS_ID" == "fedora" ]] && have dnf; then
  manifest="$HOME/.config/dnf-packages.txt"
  if [[ -f "$manifest" ]]; then
    # strip comments/blank lines
    mapfile -t pkgs < <(sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$manifest" | grep -v '^[[:space:]]*$')
    if ((${#pkgs[@]})); then
      echo "Installing/verifying ${#pkgs[@]} packages: ${pkgs[*]}"
      sudo dnf install -y "${pkgs[@]}"
    else
      warn "dnf-packages.txt has no packages listed; skipping"
    fi
  else
    warn "No $manifest found; skipping dnf install step"
  fi
else
  warn "Not Fedora (or dnf missing) — skipping dnf package install. Install the equivalents from ~/.config/dnf-packages.txt manually on this OS."
fi

################################################################################
# b. Linuxbrew
################################################################################
log "Linuxbrew"

BREW_BIN="/home/linuxbrew/.linuxbrew/bin/brew"
if [[ -x "$BREW_BIN" ]] || have brew; then
  echo "Homebrew already installed."
else
  echo "Installing Homebrew (non-interactive)..."
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if [[ -x "$BREW_BIN" ]]; then
  eval "$("$BREW_BIN" shellenv)"
elif have brew; then
  eval "$(brew shellenv)"
fi

if have brew; then
  brewfile="$HOME/.config/homebrew/Brewfile"
  if [[ -f "$brewfile" ]]; then
    echo "Running brew bundle against $brewfile ..."
    brew bundle --file="$brewfile"
  else
    warn "No $brewfile found; skipping brew bundle"
  fi
else
  warn "brew still not on PATH after install attempt — skipping brew bundle. Re-run this bootstrap after opening a new shell."
fi

################################################################################
# c. mise
################################################################################
log "mise"

if have mise; then
  echo "mise already installed ($(command -v mise))."
elif have dnf && [[ "$OS_ID" == "fedora" ]]; then
  echo "Installing mise via dnf..."
  sudo dnf install -y mise
elif have brew; then
  echo "Installing mise via brew..."
  brew install mise
else
  warn "Could not install mise (no dnf/brew available). Install manually: https://mise.jdx.dev/installing-mise.html"
fi

if have mise; then
  echo "Running mise install (uses tracked ~/.config/mise/config.toml)..."
  mise install
fi

################################################################################
# d. rustup
################################################################################
log "rustup"

if [[ -x "$HOME/.cargo/bin/rustup" ]]; then
  echo "rustup already installed."
else
  echo "Installing rustup (non-interactive)..."
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
fi

################################################################################
# e. oh-my-zsh + custom plugins
################################################################################
log "oh-my-zsh"

if [[ -d "$HOME/.oh-my-zsh" ]]; then
  echo "oh-my-zsh already installed."
else
  echo "Installing oh-my-zsh (unattended)..."
  KEEP_ZSHRC=yes RUNZSH=no CHSH=no sh -c \
    "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

log "oh-my-zsh custom plugins"

declare -A PLUGIN_REPOS=(
  [fzf-tab]="https://github.com/Aloxaf/fzf-tab"
  [zsh-autosuggestions]="https://github.com/zsh-users/zsh-autosuggestions"
  [zsh-syntax-highlighting]="https://github.com/zsh-users/zsh-syntax-highlighting.git"
  [zsh-shift-select]="https://github.com/jirutka/zsh-shift-select"
  [llm]="https://github.com/eliyastein/llm-zsh-plugin"
)

mkdir -p "$ZSH_CUSTOM/plugins"
for name in "${!PLUGIN_REPOS[@]}"; do
  dir="$ZSH_CUSTOM/plugins/$name"
  if [[ -d "$dir" ]]; then
    echo "  $name: already cloned"
  else
    echo "  $name: cloning..."
    git clone --depth 1 "${PLUGIN_REPOS[$name]}" "$dir"
  fi
done

################################################################################
# f. tmux plugin manager (TPM)
################################################################################
log "TPM (tmux plugin manager)"

if [[ -d "$HOME/.tmux/plugins/tpm" ]]; then
  echo "TPM already cloned."
else
  echo "Cloning TPM..."
  git clone --depth 1 https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
fi

if have tmux; then
  if [[ -x "$HOME/.tmux/plugins/tpm/bin/install_plugins" ]]; then
    echo "Installing tmux plugins via TPM..."
    "$HOME/.tmux/plugins/tpm/bin/install_plugins" || warn "TPM plugin install reported an error; re-run 'prefix + I' inside tmux."
  fi
else
  warn "tmux not on PATH; skipping TPM plugin install (dnf step above should have installed it)."
fi

################################################################################
# g. ~/.secrets
################################################################################
log "Secrets"

if [[ -f "$HOME/.secrets" ]]; then
  echo "\$HOME/.secrets already exists — leaving it alone."
else
  template="$HOME/.config/secrets.template"
  if [[ -f "$template" ]]; then
    cp "$template" "$HOME/.secrets"
    chmod 600 "$HOME/.secrets"
    warn "Created ~/.secrets from template with PLACEHOLDER values."
    FOLLOWUPS+=("Fill in real values in ~/.secrets (chmod 600, not tracked).")
  else
    warn "No $template found; create ~/.secrets manually (chmod 600)."
    FOLLOWUPS+=("Create ~/.secrets manually (chmod 600) — no template found.")
  fi
fi

################################################################################
# h. yadm decrypt
################################################################################
log "yadm decrypt"

GPG_KEY="D787BA76BDB81BA1"
if gpg --list-secret-keys "$GPG_KEY" >/dev/null 2>&1; then
  if have yadm; then
    echo "GPG key $GPG_KEY present — running yadm decrypt..."
    yadm decrypt || warn "yadm decrypt reported an error (archive may not exist yet on a first-ever setup)."
  else
    warn "yadm not on PATH yet; skipping decrypt. Re-run bootstrap after brew finishes."
  fi
else
  warn "GPG secret key $GPG_KEY not found — skipping yadm decrypt."
  FOLLOWUPS+=("Import GPG key $GPG_KEY (gpg --import ...), then run 'yadm decrypt'.")
fi

################################################################################
# i. summary
################################################################################
log "Bootstrap complete — manual follow-ups"

FOLLOWUPS+=(
  "gh auth login (GitHub CLI auth for git credential helper)"
  "Import your GPG key ($GPG_KEY) — needed only for yadm decrypt, not signing"
  "Copy/generate ~/.ssh/id_ed25519 (git signs with it via ssh-agent); if this
   machine uses a different key, update user.signingkey in .gitconfig and
   ~/.config/git/allowed_signers, and register the pubkey as a signing key on
   GitHub/Gitea"
  "Review/fill in ~/.secrets values"
  "Create a per-machine ~/.zshrc.local if this box needs overrides"
)

for item in "${FOLLOWUPS[@]}"; do
  echo "  - $item"
done
