#!/usr/bin/env bash
# scan-merged: For each local branch, report its upstream PR merge state so the
# agent can clean branches (and their worktrees) whose work has already merged
# upstream.
#
# Why this exists (vs the sibling `clean-gone` skill):
# In a fork workflow -- origin = your fork, upstream = the maintainer's repo --
# the maintainer typically SQUASH-merges your PR into upstream, often with extra
# edits. Your branch's original commits never become reachable from upstream, and
# your local branch keeps tracking origin/<branch> (which still exists), so git
# NEVER marks it "[gone]". `git branch -vv | grep ': gone]'` finds nothing even
# though every branch is done. The authoritative signal is the GitHub PR state,
# which is what this script gathers.
#
# Output: a TSV table (header row + one row per non-protected local branch):
#   branch  worktree  pr  pr_state  ahead_origin  tip_upstream  scratch
# ...or the literal __NONE__ if there are no non-protected branches.
#
# Columns:
#   worktree      path of the branch's worktree, or '-' if none
#   pr            upstream PR number whose head matches this branch, or '-'
#   pr_state      MERGED | OPEN | CLOSED | NONE
#   ahead_origin  commits on the local branch beyond origin/<branch> (dropped on
#                 delete), or '-' if the branch has no origin tracking ref
#   tip_upstream  yes/no: is the branch tip an ancestor of the upstream default
#                 branch? (For a SQUASH-merged PR this is normally 'no' -- not a
#                 red flag. It only matters as a tie-breaker; see SKILL.md.)
#   scratch       yes/no: name matches a throwaway pattern (TMP-*, *-original,
#                 worktree-wf_*, etc.) -- a delete candidate even with no PR.
#
# Usage: scan-merged [owner/repo]
#   owner/repo overrides the upstream repo to query (default: derived from the
#   `upstream` remote, else `origin`).

set -euo pipefail

command -v gh >/dev/null 2>&1 || {
  echo "ERROR: gh CLI not found. This skill needs GitHub PR state (install gh, then 'gh auth login')." >&2
  exit 1
}
gh auth status >/dev/null 2>&1 || {
  echo "ERROR: gh is not authenticated. Run 'gh auth login' and retry." >&2
  exit 1
}

# owner/repo from a git remote URL (handles git@host:owner/repo.git and https://host/owner/repo[.git])
parse_owner_repo() { sed -E 's#^git@[^:]+:##; s#^https?://[^/]+/##; s#\.git$##' <<<"$1"; }

# Pick the remote that represents the merge target: prefer `upstream`, fall back to `origin`.
UPSTREAM_REMOTE=""
for r in upstream origin; do
  if git remote get-url "$r" >/dev/null 2>&1; then UPSTREAM_REMOTE="$r"; break; fi
done
[[ -n "$UPSTREAM_REMOTE" ]] || { echo "ERROR: no 'upstream' or 'origin' remote found." >&2; exit 1; }

REPO="${1:-$(parse_owner_repo "$(git remote get-url "$UPSTREAM_REMOTE")")}"

# Your fork's owner -- used to disambiguate when two contributors share a head-branch name.
FORK_OWNER=""
if git remote get-url origin >/dev/null 2>&1; then
  FORK_OWNER="$(parse_owner_repo "$(git remote get-url origin)" | cut -d/ -f1)"
fi

# Refresh remote state and resolve the upstream default branch (for the tip check).
git fetch "$UPSTREAM_REMOTE" --prune >/dev/null 2>&1 || true
UPSTREAM_DEFAULT="$(git symbolic-ref -q --short "refs/remotes/$UPSTREAM_REMOTE/HEAD" 2>/dev/null || true)"
[[ -n "$UPSTREAM_DEFAULT" ]] || UPSTREAM_DEFAULT="$UPSTREAM_REMOTE/main"

# Pull every PR once and index locally -- far cheaper than one API call per branch.
PRS="$(gh pr list --repo "$REPO" --state all --limit 500 \
  --json number,state,headRefName,headRepositoryOwner \
  --jq '.[] | [.headRefName, (.headRepositoryOwner.login // ""), (.number|tostring), .state] | @tsv' 2>/dev/null || true)"

# Best PR row for a branch name: prefer rows from your fork owner, then MERGED/OPEN over CLOSED.
pr_for() {
  awk -F'\t' -v b="$1" -v fo="$FORK_OWNER" '
    $1==b {
      score = 1
      if (fo != "" && $2 == fo) score += 10
      if      ($4 == "MERGED") score += 4
      else if ($4 == "OPEN")   score += 3
      else if ($4 == "CLOSED") score += 1
      if (score > best) { best = score; out = $3 "\t" $4 }
    }
    END { if (out != "") print out }
  ' <<<"$PRS"
}

# Map branch -> worktree path.
declare -A WT
cur_path=""
while IFS= read -r line; do
  case "$line" in
    "worktree "*)          cur_path="${line#worktree }" ;;
    "branch refs/heads/"*) WT["${line#branch refs/heads/}"]="$cur_path" ;;
  esac
done < <(git worktree list --porcelain)

is_protected() { [[ "$1" == "main" || "$1" == "master" || "$1" == "${UPSTREAM_DEFAULT##*/}" ]]; }
is_scratch()  { [[ "$1" == TMP-* || "$1" == tmp/* || "$1" == *-original || "$1" == worktree-wf_* || "$1" == wf_* ]]; }

mapfile -t BRANCHES < <(git for-each-ref --format='%(refname:short)' refs/heads/)
[[ ${#BRANCHES[@]} -gt 0 ]] || { echo "__NONE__"; exit 0; }

CURRENT="$(git symbolic-ref -q --short HEAD || true)"

printf 'branch\tworktree\tpr\tpr_state\tahead_origin\ttip_upstream\tscratch\n'
emitted=0
for b in "${BRANCHES[@]}"; do
  is_protected "$b" && continue
  [[ "$b" == "$CURRENT" ]] && continue   # the checked-out branch cannot be deleted

  wt="${WT[$b]:--}"

  prinfo="$(pr_for "$b")"
  if [[ -n "$prinfo" ]]; then
    pr="#$(cut -f1 <<<"$prinfo")"; state="$(cut -f2 <<<"$prinfo")"
  else
    pr="-"; state="NONE"
  fi

  if git rev-parse --verify -q "origin/$b" >/dev/null; then
    ahead="$(git rev-list --count "origin/$b..$b" 2>/dev/null || echo '?')"
  else
    ahead="-"
  fi

  git merge-base --is-ancestor "$b" "$UPSTREAM_DEFAULT" 2>/dev/null && tip="yes" || tip="no"
  is_scratch "$b" && scr="yes" || scr="no"

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$b" "$wt" "$pr" "$state" "$ahead" "$tip" "$scr"
  emitted=1
done

[[ $emitted -eq 1 ]] || echo "__NONE__"
