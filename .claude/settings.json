{
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": [
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_context",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_status",
      "Bash(bd show *)",
      "Bash(bd ready)",
      "Bash(bd ready *)",
      "Bash(bd list)",
      "Bash(bd list *)",
      "Bash(bd tree)",
      "Bash(bd tree *)",
      "Bash(bd stats)",
      "Bash(bd stats *)",
      "Bash(bd search *)",
      "Bash(bd memories)",
      "Bash(bd memories *)",
      "Bash(dig *)",
      "Bash(kata list)",
      "Bash(kata list *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(gh search *)",
      "Bash(go doc *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(kata search *)",
      "Bash(kata show *)",
      "Bash(pnpm lint)",
      "mcp__agentsview__get_messages",
      "mcp__agentsview__get_session_overview",
      "mcp__agentsview__list_sessions",
      "mcp__codegraph__codegraph_explore"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "roborev agent-hook run"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dcg"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v dcg >/dev/null 2>&1 || exit 0; exec dcg"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "roborev agent-hook run"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "roborev agent-hook run"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "unifi-network@unifi-plugins": true,
    "superpowers@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "session-report@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "verbose": true,
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "skillOverrides": {
    "_gstack-command": "off",
    "autoplan": "off",
    "benchmark": "off",
    "benchmark-models": "off",
    "brainstorming": "off",
    "browse": "off",
    "canary": "off",
    "careful": "off",
    "codex": "off",
    "context-restore": "off",
    "context-save": "off",
    "cso": "off",
    "design-consultation": "off",
    "design-html": "off",
    "design-review": "off",
    "design-shotgun": "off",
    "devex-review": "off",
    "dispatching-parallel-agents": "off",
    "document-generate": "off",
    "document-release": "off",
    "executing-plans": "off",
    "finishing-a-development-branch": "off",
    "freeze": "off",
    "gstack": "off",
    "guard": "off",
    "health": "off",
    "investigate": "off",
    "ios-clean": "off",
    "ios-design-review": "off",
    "ios-fix": "off",
    "ios-qa": "off",
    "ios-sync": "off",
    "land-and-deploy": "off",
    "landing-report": "off",
    "make-pdf": "off",
    "office-hours": "off",
    "pair-agent": "off",
    "plan-ceo-review": "off",
    "plan-design-review": "off",
    "plan-devex-review": "off",
    "plan-eng-review": "off",
    "plan-tune": "off",
    "qa": "off",
    "qa-only": "off",
    "receiving-code-review": "off",
    "requesting-code-review": "off",
    "retro": "off",
    "review": "off",
    "scrape": "off",
    "setup-browser-cookies": "off",
    "setup-gbrain": "off",
    "ship": "off",
    "skillify": "off",
    "spec": "off",
    "subagent-driven-development": "off",
    "sync-gbrain": "off",
    "systematic-debugging": "off",
